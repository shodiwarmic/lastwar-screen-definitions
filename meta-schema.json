{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lastwar-tools/screen-definition/v1",
  "title": "Last War Screen Definition",
  "description": "Describes a single game screen that any platform adapter can consume to locate, classify, and extract player data from screenshots.",
  "type": "object",
  "required": ["id", "version", "name", "identification", "boundaries", "columns", "row_clustering"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Canonical identifier. Maps directly to the backend category key (e.g. 'daily_ranking', 'weekly_ranking', 'strength_ranking')."
    },
    "version": { "type": "integer", "minimum": 1 },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "identification": {
      "type": "object",
      "required": ["page_signals"],
      "additionalProperties": false,
      "properties": {
        "page_signals": { "type": "array", "items": {"type": "string"}, "minItems": 1 },
        "negative_signals": { "type": "array", "items": {"type": "string"} },
        "pre_ocr_hint": { "$ref": "#/$defs/pre_ocr_hint" }
      }
    },
    "boundaries": {
      "type": "object",
      "required": ["header", "footer"],
      "additionalProperties": false,
      "properties": {
        "header": { "$ref": "#/$defs/boundary_anchor" },
        "footer": { "$ref": "#/$defs/boundary_anchor" }
      }
    },
    "chrome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "top_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "bottom_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "tabs": { "$ref": "#/$defs/tabs_definition" },
    "columns": { "type": "array", "items": { "$ref": "#/$defs/column_definition" }, "minItems": 1 },
    "row_clustering": { "$ref": "#/$defs/row_clustering" }
  },
  "$defs": {
    "normalized_region": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_min": {"type": "number", "minimum": 0, "maximum": 1},
        "x_max": {"type": "number", "minimum": 0, "maximum": 1},
        "y_min": {"type": "number", "minimum": 0, "maximum": 1},
        "y_max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "color_definition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "named": { "type": "string", "enum": ["orange", "white"] },
        "hsv_override": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "h_min": {"type": "number", "minimum": 0, "maximum": 1},
            "h_max": {"type": "number", "minimum": 0, "maximum": 1},
            "s_min": {"type": "number", "minimum": 0, "maximum": 1},
            "v_min": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "pre_ocr_hint": {
      "type": "object",
      "required": ["x_hint", "y_hint", "color"],
      "additionalProperties": false,
      "properties": {
        "x_hint": {"type": "number", "minimum": 0, "maximum": 1},
        "y_hint": {"type": "number", "minimum": 0, "maximum": 1},
        "color": { "$ref": "#/$defs/color_definition" },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.88}
      }
    },
    "boundary_anchor": {
      "type": "object",
      "required": ["signals"],
      "additionalProperties": false,
      "properties": {
        "signals": { "type": "array", "items": {"type": "string"}, "minItems": 1 },
        "search_region": { "$ref": "#/$defs/normalized_region" },
        "anchor_offset": {
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "type": "string", "enum": ["below_bottom_edge", "above_top_edge"] },
            "offset_fraction": {"type": "number", "default": 0.0}
          }
        }
      }
    },
    "tab_active_indicator": {
      "type": "object",
      "required": ["strategy"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["brightest", "color_fraction"] },
        "min_gap": {"type": "number", "default": 0.04},
        "min_fraction": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.10},
        "color": { "$ref": "#/$defs/color_definition" },
        "bbox_padding_fraction": {"type": "number", "default": 0.007}
      }
    },
    "tab_item": {
      "type": "object",
      "required": ["id", "category", "signals"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "category": {"type": "string"},
        "signals": { "type": "array", "items": {"type": "string"}, "minItems": 1 },
        "x_hint": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "tabs_definition": {
      "type": "object",
      "required": ["active_indicator", "items"],
      "additionalProperties": false,
      "properties": {
        "search_region": { "$ref": "#/$defs/normalized_region" },
        "y_hint": {"type": "number", "minimum": 0, "maximum": 1},
        "active_indicator": { "$ref": "#/$defs/tab_active_indicator" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/tab_item" }, "minItems": 1 }
      }
    },
    "column_definition": {
      "type": "object",
      "required": ["id", "type", "x_min", "x_max"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": { "type": "string", "enum": ["name", "score", "ignore"] },
        "x_min": {"type": "number", "minimum": 0, "maximum": 1},
        "x_max": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "row_clustering": {
      "type": "object",
      "required": ["strategy", "min_score"],
      "additionalProperties": false,
      "properties": {
        "strategy": { "type": "string", "enum": ["score_anchored", "y_proximity"] },
        "score_anchored": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "up_band_fraction": {"type": "number", "default": 0.021},
            "down_band_fraction": {"type": "number", "default": 0.002}
          }
        },
        "y_proximity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tolerance_fraction": {"type": "number", "default": 0.02},
            "min_tolerance_px": {"type": "integer", "default": 20}
          }
        },
        "min_score": {"type": "integer", "default": 1000},
        "word_gap_fraction": {"type": "number", "default": 0.015},
        "min_word_gap_px": {"type": "integer", "default": 8}
      }
    }
  }
}
